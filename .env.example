DB_URL=jdbc:mysql://localhost:3306/mayday
DB_USERNAME=root
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-byte-secret-value
JWT_ACCESS_TOKEN_EXPIRATION=3600000
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_EMAIL=mayday@demo.local
DEMO_LOGIN_PASSWORD=replace-with-a-strong-demo-password
OPENAI_API_KEY=change-me

# Required only when using Google Cloud Vision OCR.
# Set either GOOGLE_VISION_API_KEY or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_VISION_API_KEY=change-me

# Use an absolute path to a local service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-credentials.json
